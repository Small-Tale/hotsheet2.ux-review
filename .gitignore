# --- Hot Sheet local data ---
# HS2 checkout-local files stay local except the shared project settings file.
/.hotsheet/
/.hotsheet2/*
!/.hotsheet2/settings.json

# --- AI-tool local + harness files (machine-specific absolute paths) ---
/.claude/settings.local.json
/.claude/worktrees/
/.codex/config.toml
/.codex/config.local.toml
/.codex/hooks.json
/.agents/mcp_config.json
/.agents/**/settings.local.json
/.mcp.json
/opencode.json
.cc-writes/

# --- Secrets / certificates (never commit) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# --- Swift / Xcode build output ---
.build/
.swiftpm/
DerivedData/
build/
*.xcodeproj/
# Generated by XcodeGen from macos/project.yml
/macos/App/Info.plist
*.xcworkspace/
# Machine-local code signing identity (see macos/Signing.xcconfig)
/macos/Signing.local.xcconfig
xcuserdata/
*.xcresult

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
.hotsheet2/settings.local.json
